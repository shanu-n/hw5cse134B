<header>
    <img src="/media/logo.png" alt="Shanmukhi Nandiraju Logo" width="50" height="50">
    <b>{{ site.authorName }}</b>

    <nav>
        <ul>
            {% for item in site.nav %}
                <li><a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
        </ul>
    </nav>

    <section id="theme-switcher" hidden>
        <label for="theme-select">Vibe:</label>
        <select id="theme-select">
            <option value="system">System Default</option>
            <option value="nostalgia">2014 Summer</option>
            <option value="dark">King Kylie (Dark)</option>
        </select>
    </section>
</header>